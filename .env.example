# Pixelverse Environment Configuration
# Copy this file to .env.local for local development.

# Supabase Configuration
# For local or development without Supabase, Pixelverse will automatically run
# in standalone/mock mode with built-in persistent storage and simulated real-time!
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# LiveKit SFU Voice Configuration (Optional - fallback to WebRTC Mesh / Audio Context simulator is built-in)
NEXT_PUBLIC_LIVEKIT_WS_URL=wss://pixelverse-demo.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_ENABLE_AUDIO_FX=true

# GameMonetize Integration
# The site's game catalog is built from this feed:  npm run sync:feed
GAMEMONETIZE_FEED_URL=https://rss.gamemonetize.com/rssfeed.php?format=json&category=All&type=html5&popularity=newest&company=All&amount=All
